<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Tasty Bites – Palam, New Delhi</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --saffron:#FF6B00;--deep:#1A0A00;--cream:#FFF8EE;--gold:#FFBA08;
  --rust:#C1440E;--green:#2D6A4F;--text:#1A0A00;--muted:#7a5a40;
}
html{scroll-behavior:smooth}
body{font-family:'DM Sans',sans-serif;background:var(--cream);color:var(--text);overflow-x:hidden;cursor:none}

/* custom cursor */
#cursor{position:fixed;width:12px;height:12px;background:var(--saffron);border-radius:50%;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);transition:transform 0.1s,width 0.2s,height 0.2s,opacity 0.2s;mix-blend-mode:multiply}
#cursor-ring{position:fixed;width:36px;height:36px;border:1.5px solid var(--saffron);border-radius:50%;pointer-events:none;z-index:9998;transform:translate(-50%,-50%);transition:transform 0.15s,left 0.08s,top 0.08s;opacity:0.5}
body:not(.has-touch) *:hover ~ #cursor{transform:translate(-50%,-50%) scale(2)}

/* sparks canvas */
#sparks{position:fixed;inset:0;pointer-events:none;z-index:9997}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;align-items:center;justify-content:space-between;padding:1rem 2.5rem;background:rgba(255,248,238,0.92);backdrop-filter:blur(12px);border-bottom:1px solid rgba(255,107,0,0.15);animation:slideDown 0.6s ease both}
@keyframes slideDown{from{transform:translateY(-60px);opacity:0}to{transform:translateY(0);opacity:1}}
.nav-logo{font-family:'Playfair Display',serif;font-size:1.4rem;font-weight:900;color:var(--saffron)}
.nav-logo span{color:var(--rust)}
.nav-links{display:flex;gap:2rem;list-style:none}
.nav-links a{text-decoration:none;color:var(--muted);font-size:0.9rem;font-weight:500;transition:color 0.2s;letter-spacing:0.04em;text-transform:uppercase;position:relative}
.nav-links a::after{content:'';position:absolute;bottom:-3px;left:0;right:0;height:2px;background:var(--saffron);transform:scaleX(0);transition:transform 0.2s;transform-origin:left}
.nav-links a:hover{color:var(--saffron)}
.nav-links a:hover::after{transform:scaleX(1)}

/* HERO */
#hero{min-height:100vh;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;background:var(--deep)}
.hero-img{position:absolute;inset:0;object-fit:cover;width:100%;height:100%;opacity:0.22;animation:heroZoom 18s ease-in-out infinite alternate}
@keyframes heroZoom{from{transform:scale(1)}to{transform:scale(1.12)}}
.hero-overlay{position:absolute;inset:0;background:linear-gradient(to bottom,rgba(26,10,0,0.6) 0%,rgba(26,10,0,0.82) 100%)}
.particles{position:absolute;inset:0;overflow:hidden}
.particle{position:absolute;width:3px;height:3px;border-radius:50%;background:var(--gold);animation:particleRise linear infinite}
@keyframes particleRise{0%{transform:translateY(100vh) scale(0);opacity:0}20%{opacity:1}80%{opacity:0.6}100%{transform:translateY(-100px) scale(1);opacity:0}}
.ring{position:absolute;border-radius:50%;border:1px solid rgba(255,107,0,0.15);animation:pulsering 5s ease-in-out infinite}
.ring:nth-child(1){width:380px;height:380px;top:50%;left:50%;transform:translate(-50%,-50%);animation-delay:0s}
.ring:nth-child(2){width:620px;height:620px;top:50%;left:50%;transform:translate(-50%,-50%);animation-delay:1s}
.ring:nth-child(3){width:880px;height:880px;top:50%;left:50%;transform:translate(-50%,-50%);animation-delay:2s}
@keyframes pulsering{0%,100%{opacity:0.3;transform:translate(-50%,-50%) scale(1)}50%{opacity:0.9;transform:translate(-50%,-50%) scale(1.03)}}
.floater{position:absolute;font-size:2.2rem;pointer-events:none;animation:floatUp linear infinite;filter:drop-shadow(0 0 8px rgba(255,186,8,0.4))}
@keyframes floatUp{0%{transform:translateY(110vh) rotate(0deg);opacity:0}10%{opacity:0.3}90%{opacity:0.15}100%{transform:translateY(-10vh) rotate(360deg);opacity:0}}
.hero-content{position:relative;z-index:2;text-align:center;padding:2rem}
.hero-badge{display:inline-flex;align-items:center;gap:0.5rem;background:rgba(255,107,0,0.18);border:1px solid rgba(255,107,0,0.4);color:var(--gold);font-size:0.8rem;letter-spacing:0.15em;text-transform:uppercase;padding:0.4rem 1.2rem;border-radius:50px;margin-bottom:1.5rem;animation:fadeUp 0.8s 0.3s ease both}
.hero-badge-dot{width:7px;height:7px;border-radius:50%;background:var(--gold);animation:blink 1.5s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0.2}}
.hero-title{font-family:'Playfair Display',serif;font-size:clamp(3rem,9vw,7rem);font-weight:900;line-height:1.02;color:var(--cream);animation:fadeUp 0.8s 0.5s ease both}
.hero-title .accent{color:var(--saffron);display:block;font-style:italic}
.hero-hindi{font-size:1.1rem;color:rgba(255,248,238,0.4);margin-top:0.5rem;letter-spacing:0.06em;animation:fadeUp 0.8s 0.65s ease both}
.hero-stars{margin-top:1.5rem;display:flex;align-items:center;justify-content:center;gap:0.5rem;animation:fadeUp 0.8s 0.75s ease both}
.star{color:var(--gold);font-size:1.1rem}
.hero-stars span{color:rgba(255,248,238,0.55);font-size:0.9rem}
.hero-ctas{margin-top:2.5rem;display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;animation:fadeUp 0.8s 0.9s ease both}
.btn-primary{background:var(--saffron);color:#fff;border:none;cursor:none;padding:0.9rem 2.2rem;border-radius:50px;font-family:'DM Sans',sans-serif;font-weight:500;font-size:1rem;transition:transform 0.2s,box-shadow 0.2s,letter-spacing 0.2s;text-decoration:none;display:inline-block}
.btn-primary:hover{transform:translateY(-3px) scale(1.04);box-shadow:0 10px 40px rgba(255,107,0,0.5);letter-spacing:0.04em}
.btn-outline{background:transparent;color:var(--cream);border:1px solid rgba(255,248,238,0.3);cursor:none;padding:0.9rem 2.2rem;border-radius:50px;font-family:'DM Sans',sans-serif;font-weight:500;font-size:1rem;transition:all 0.2s;text-decoration:none;display:inline-block}
.btn-outline:hover{border-color:var(--gold);color:var(--gold);transform:translateY(-3px)}
@keyframes fadeUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
.scroll-indicator{position:absolute;bottom:2rem;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:0.4rem;color:rgba(255,248,238,0.3);font-size:0.75rem;letter-spacing:0.1em;animation:fadeUp 1s 1.2s ease both}
.scroll-line{width:1px;height:50px;background:linear-gradient(to bottom,transparent,rgba(255,107,0,0.6));animation:scrollLine 1.8s ease-in-out infinite}
@keyframes scrollLine{0%,100%{transform:scaleY(0);transform-origin:top}50%{transform:scaleY(1);transform-origin:top}51%{transform:scaleY(1);transform-origin:bottom}99%{transform:scaleY(0);transform-origin:bottom}}

/* SECTIONS */
section{padding:6rem 2rem}
.section-label{font-size:0.75rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--saffron);font-weight:500;margin-bottom:0.8rem}
.section-title{font-family:'Playfair Display',serif;font-size:clamp(2rem,4vw,3rem);font-weight:700;line-height:1.2;color:var(--text);margin-bottom:1rem}
.section-sub{color:var(--muted);font-size:1rem;line-height:1.7;max-width:520px}
.container{max-width:1100px;margin:0 auto}
.reveal{opacity:0;transform:translateY(40px);transition:opacity 0.75s ease,transform 0.75s ease}
.reveal.visible{opacity:1;transform:none}
.reveal-left{opacity:0;transform:translateX(-40px);transition:opacity 0.75s ease,transform 0.75s ease}
.reveal-left.visible{opacity:1;transform:none}
.reveal-right{opacity:0;transform:translateX(40px);transition:opacity 0.75s ease,transform 0.75s ease}
.reveal-right.visible{opacity:1;transform:none}
.reveal-scale{opacity:0;transform:scale(0.88);transition:opacity 0.7s ease,transform 0.7s ease}
.reveal-scale.visible{opacity:1;transform:scale(1)}

/* PHOTO GALLERY strip */
#gallery{background:var(--deep);padding:3rem 0;overflow:hidden}
.gallery-track{display:flex;gap:1rem;animation:marquee 28s linear infinite;width:max-content}
.gallery-track:hover{animation-play-state:paused}
.gallery-img{width:260px;height:180px;object-fit:cover;border-radius:12px;flex-shrink:0;filter:brightness(0.85) saturate(1.2);transition:transform 0.3s,filter 0.3s}
.gallery-img:hover{transform:scale(1.06);filter:brightness(1) saturate(1.4)}
@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}

/* ABOUT */
#about{background:#fff}
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center}
.about-img-wrap{position:relative}
.about-main-img{width:100%;border-radius:20px;aspect-ratio:4/3;object-fit:cover;display:block;animation:imgFloat 5s ease-in-out infinite}
@keyframes imgFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
.about-img-badge{position:absolute;bottom:-1.2rem;right:-1.2rem;background:var(--saffron);color:#fff;border-radius:16px;padding:1rem 1.4rem;box-shadow:0 8px 30px rgba(255,107,0,0.35)}
.about-img-badge .big{font-family:'Playfair Display',serif;font-size:2rem;font-weight:900;display:block;line-height:1}
.about-img-badge .sm{font-size:0.75rem;opacity:0.85;letter-spacing:0.05em}
.about-stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:2rem}
.stat-card{background:var(--cream);border:1px solid rgba(255,107,0,0.15);border-radius:12px;padding:1.2rem;transition:transform 0.2s,border-color 0.2s}
.stat-card:hover{transform:translateY(-4px);border-color:var(--saffron)}
.stat-num{font-family:'Playfair Display',serif;font-size:2rem;color:var(--saffron)}
.stat-lbl{font-size:0.82rem;color:var(--muted);margin-top:0.2rem}

/* MENU */
#menu{background:var(--deep)}
#menu .section-title{color:var(--cream)}
#menu .section-label{color:var(--gold)}
#menu .section-sub{color:rgba(255,248,238,0.5)}
.menu-filter{display:flex;gap:0.6rem;flex-wrap:wrap;margin:2rem 0}
.filter-btn{padding:0.4rem 1.2rem;border-radius:50px;border:1px solid rgba(255,248,238,0.2);background:transparent;color:rgba(255,248,238,0.55);cursor:none;font-family:'DM Sans',sans-serif;font-size:0.85rem;transition:all 0.25s}
.filter-btn.active,.filter-btn:hover{background:var(--saffron);border-color:var(--saffron);color:#fff;transform:translateY(-2px)}
.menu-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:1.5rem}
.menu-card{background:rgba(255,248,238,0.04);border:1px solid rgba(255,248,238,0.08);border-radius:18px;overflow:hidden;transition:transform 0.35s,border-color 0.35s,box-shadow 0.35s;cursor:none}
.menu-card:hover{transform:translateY(-8px) scale(1.02);border-color:rgba(255,107,0,0.45);box-shadow:0 20px 60px rgba(255,107,0,0.15)}
.menu-card-img{width:100%;height:160px;object-fit:cover;display:block;transition:transform 0.5s}
.menu-card:hover .menu-card-img{transform:scale(1.08)}
.menu-card-body{padding:1.2rem}
.menu-name{font-family:'Playfair Display',serif;font-size:1.05rem;color:var(--cream);font-weight:700}
.menu-desc{font-size:0.82rem;color:rgba(255,248,238,0.42);margin-top:0.4rem;line-height:1.5}
.menu-footer{display:flex;align-items:center;justify-content:space-between;margin-top:0.9rem}
.menu-price{font-size:0.95rem;color:var(--gold);font-weight:500}
.menu-tag{font-size:0.68rem;padding:0.15rem 0.6rem;border-radius:50px;background:rgba(45,106,79,0.25);color:#6fcf97}
.menu-tag.spicy{background:rgba(193,68,14,0.25);color:#ff9f7a}

/* GALLERY MOSAIC */
#photos{background:#fff}
.mosaic{display:grid;grid-template-columns:repeat(4,1fr);grid-template-rows:auto;gap:1rem;margin-top:2.5rem}
.mosaic-item{overflow:hidden;border-radius:14px;position:relative;cursor:none}
.mosaic-item img{width:100%;height:100%;object-fit:cover;display:block;transition:transform 0.5s,filter 0.5s}
.mosaic-item:hover img{transform:scale(1.1);filter:brightness(1.1) saturate(1.3)}
.mosaic-item::after{content:attr(data-label);position:absolute;inset:0;background:rgba(26,10,0,0.5);display:flex;align-items:flex-end;padding:1rem;color:var(--cream);font-family:'Playfair Display',serif;font-size:0.95rem;opacity:0;transition:opacity 0.3s}
.mosaic-item:hover::after{opacity:1}
.mosaic-item:nth-child(1){grid-column:span 2;grid-row:span 2;min-height:280px}
.mosaic-item:nth-child(2),.mosaic-item:nth-child(3){min-height:140px}
.mosaic-item:nth-child(4),.mosaic-item:nth-child(5){min-height:140px}
.mosaic-item:nth-child(6){grid-column:span 2;min-height:140px}

/* REVIEWS */
#reviews{background:linear-gradient(135deg,#fff 60%,rgba(255,107,0,0.04) 100%)}
.reviews-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.5rem;margin-top:2.5rem}
.review-card{border:1px solid rgba(255,107,0,0.1);border-radius:18px;padding:1.8rem;position:relative;overflow:hidden;background:#fff;transition:transform 0.3s,box-shadow 0.3s}
.review-card::before{content:'"';position:absolute;top:-1rem;right:1rem;font-family:'Playfair Display',serif;font-size:8rem;color:rgba(255,107,0,0.06);line-height:1;pointer-events:none}
.review-card:hover{transform:translateY(-6px);box-shadow:0 16px 50px rgba(255,107,0,0.12)}
.review-card-shine{position:absolute;top:-50%;left:-50%;width:60%;height:200%;background:linear-gradient(105deg,transparent 40%,rgba(255,186,8,0.08) 50%,transparent 60%);transform:rotate(0deg);transition:transform 0.6s;pointer-events:none}
.review-card:hover .review-card-shine{transform:translateX(200%)}
.reviewer{display:flex;align-items:center;gap:0.8rem;margin-bottom:1rem}
.avatar{width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:0.9rem;flex-shrink:0;animation:avatarPop 0.4s ease both}
@keyframes avatarPop{from{transform:scale(0);opacity:0}to{transform:scale(1);opacity:1}}
.reviewer-name{font-weight:500;font-size:0.95rem}
.reviewer-meta{font-size:0.8rem;color:var(--muted)}
.review-stars{display:flex;gap:2px;margin-bottom:0.8rem}
.review-text{font-size:0.9rem;line-height:1.7;color:#444}

/* COUNTER SECTION */
#counters{background:var(--saffron);padding:4rem 2rem}
.counters-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:2rem;max-width:900px;margin:0 auto;text-align:center}
.counter-item .num{font-family:'Playfair Display',serif;font-size:3.5rem;font-weight:900;color:#fff;line-height:1}
.counter-item .label{font-size:0.85rem;color:rgba(255,255,255,0.75);text-transform:uppercase;letter-spacing:0.12em;margin-top:0.4rem}
.counter-item .num-suffix{font-size:2rem}

/* INFO */
#info{background:var(--deep);padding:5rem 2rem}
.info-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:2rem;max-width:1000px;margin:0 auto}
.info-item{text-align:center;padding:2rem;border:1px solid rgba(255,107,0,0.12);border-radius:16px;transition:border-color 0.3s,transform 0.3s,background 0.3s}
.info-item:hover{border-color:rgba(255,107,0,0.4);transform:translateY(-6px);background:rgba(255,107,0,0.06)}
.info-icon{font-size:2.2rem;margin-bottom:0.8rem;animation:iconBob 3s ease-in-out infinite}
.info-item:nth-child(2) .info-icon{animation-delay:0.3s}
.info-item:nth-child(3) .info-icon{animation-delay:0.6s}
.info-item:nth-child(4) .info-icon{animation-delay:0.9s}
@keyframes iconBob{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
.info-label{font-size:0.72rem;text-transform:uppercase;letter-spacing:0.12em;color:rgba(255,248,238,0.45)}
.info-val{font-family:'Playfair Display',serif;font-size:1.05rem;color:var(--cream);font-weight:700;margin-top:0.4rem;line-height:1.5}

/* FOOTER */
footer{background:#0e0500;text-align:center;padding:2.5rem 1rem;color:rgba(255,248,238,0.25);font-size:0.85rem;border-top:1px solid rgba(255,107,0,0.1)}
footer strong{color:var(--saffron)}
.footer-wave{width:100%;overflow:hidden;line-height:0;background:var(--deep)}
.footer-wave svg{display:block}

@media(max-width:700px){
  nav{padding:0.9rem 1.2rem}
  .nav-links{display:none}
  .about-grid{grid-template-columns:1fr}
  .mosaic{grid-template-columns:1fr 1fr}
  .mosaic-item:nth-child(1){grid-column:span 2;min-height:180px}
  .mosaic-item:nth-child(6){grid-column:span 2}
}
</style>
</head>
<body>

<canvas id="sparks"></canvas>
<div id="cursor"></div>
<div id="cursor-ring"></div>

<!-- NAV -->
<nav>
  <div class="nav-logo">Tasty<span>Bites</span></div>
  <ul class="nav-links">
    <li><a href="#about">About</a></li>
    <li><a href="#menu">Menu</a></li>
    <li><a href="#photos">Gallery</a></li>
    <li><a href="#reviews">Reviews</a></li>
    <li><a href="#info">Visit Us</a></li>
  </ul>
</nav>

<!-- HERO -->
<section id="hero">
  <img class="hero-img" src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1400&q=80" alt="Delicious food spread">
  <div class="hero-overlay"></div>
  <div class="particles" id="particles"></div>
  <div class="ring"></div><div class="ring"></div><div class="ring"></div>
  <span class="floater" style="left:6%;animation-duration:10s;animation-delay:0s">🥟</span>
  <span class="floater" style="left:16%;animation-duration:14s;animation-delay:2s">🍕</span>
  <span class="floater" style="left:27%;animation-duration:11s;animation-delay:4.5s">🍜</span>
  <span class="floater" style="left:45%;animation-duration:9s;animation-delay:1.5s">🍔</span>
  <span class="floater" style="left:60%;animation-duration:13s;animation-delay:3s">🧆</span>
  <span class="floater" style="left:74%;animation-duration:12s;animation-delay:0.5s">🍛</span>
  <span class="floater" style="left:86%;animation-duration:10s;animation-delay:2.5s">🌶️</span>
  <span class="floater" style="left:92%;animation-duration:15s;animation-delay:6s">🥘</span>
  <div class="hero-content">
    <div class="hero-badge"><span class="hero-badge-dot"></span> Open Now · Palam, New Delhi</div>
    <h1 class="hero-title">The<br><span class="accent">Tasty Bites</span></h1>
    <p class="hero-hindi">थे टेस्टी बाइट्स</p>
    <div class="hero-stars">
      <span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star" style="opacity:0.35">★</span>
      <span>4.4 · 86 reviews · ₹200–400</span>
    </div>
    <div class="hero-ctas">
      <a href="#menu" class="btn-primary">Explore Menu</a>
      <a href="#info" class="btn-outline">Get Directions</a>
    </div>
  </div>
  <div class="scroll-indicator"><span>SCROLL</span><div class="scroll-line"></div></div>
</section>

<!-- GALLERY MARQUEE -->
<div id="gallery">
  <div class="gallery-track" id="galleryTrack">
    <img class="gallery-img" src="https://images.unsplash.com/photo-1631515243349-e0cb75fb8d3a?w=400&q=75" alt="Momos">
    <img class="gallery-img" src="https://images.unsplash.com/photo-1569718212165-3a8278d5f624?w=400&q=75" alt="Noodles">
    <img class="gallery-img" src="https://images.unsplash.com/photo-1513104890138-7c749659a591?w=400&q=75" alt="Pizza">
    <img class="gallery-img" src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=400&q=75" alt="Burger">
    <img class="gallery-img" src="https://images.unsplash.com/photo-1585937421612-70a008356fbe?w=400&q=75" alt="Curry">
    <img class="gallery-img" src="https://images.unsplash.com/photo-1603133872878-684f208fb84b?w=400&q=75" alt="Fried Rice">
    <img class="gallery-img" src="https://images.unsplash.com/photo-1567188040759-fb8a883dc6d8?w=400&q=75" alt="Naan">
    <img class="gallery-img" src="https://images.unsplash.com/photo-1544025162-d76694265947?w=400&q=75" alt="Spring Roll">
    <!-- duplicate for seamless loop -->
    <img class="gallery-img" src="https://images.unsplash.com/photo-1631515243349-e0cb75fb8d3a?w=400&q=75" alt="Momos">
    <img class="gallery-img" src="https://images.unsplash.com/photo-1569718212165-3a8278d5f624?w=400&q=75" alt="Noodles">
    <img class="gallery-img" src="https://images.unsplash.com/photo-1513104890138-7c749659a591?w=400&q=75" alt="Pizza">
